  "inputs": [
    {
      "id": "startStop",
      "type": "promptString",
      "description": "Przystanek poczatkowy A (ID)",
      "default": "1413380"
    },
    {
      "id": "endStop",
      "type": "promptString",
      "description": "Przystanek koncowy B (ID)",
      "default": "1413387"
    },
    {
      "id": "visitList",
      "type": "promptString",
      "description": "Lista przystankow L oddzielona srednikiem",
      "default": "1413426;1413380;1413332;1413100;1413387"
    },
    {
      "id": "criterion",
      "type": "pickString",
      "description": "Kryterium optymalizacji",
      "options": [
        "t",
        "p"
      ],
      "default": "t"
    },
    {
      "id": "startTime",
      "type": "promptString",
      "description": "Czas startu (YYYY-MM-DD HH:MM:SS)",
      "default": "2026-03-26 07:00:00"
    },
    {
      "id": "abVariant",
      "type": "pickString",
      "description": "Algorytm dla trybu A->B",
      "options": [
        "dijkstra",
        "astar"
      ],
      "default": "dijkstra"
    },
    {
      "id": "tabuVariant",
      "type": "pickString",
      "description": "Wariant Tabu Search",
      "options": [
        "basic",
        "variable_tenure",
        "aspiration",
        "adaptive"
      ],
      "default": "basic"
    },
    {
      "id": "iterations",
      "type": "promptString",
      "description": "Liczba iteracji Tabu Search",
      "default": "80"
    },
    {
      "id": "maxWaiting",
      "type": "promptString",
      "description": "Maksymalny czas oczekiwania na przesiadke (sekundy)",
      "default": "3600"
    }
  ]
